# AI_GATEWAY_KEY: OpenRouter API key. Powers the server AI routes (/api/hermes, /api/scan,
# /api/scan-room, /api/scan-receipt) via lib/ai-gateway.ts. Get from: https://openrouter.ai/keys
AI_GATEWAY_KEY=""

# GEMINI_API_KEY: Google AI Studio key. Powers avatar image generation (/api/avatar via
# lib/google-image.ts, gemini-2.5-flash-image). Get from: https://aistudio.google.com
GEMINI_API_KEY=""

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=219789823950-2gl88f07lmju2m5nkeo07bhptdila3pd.apps.googleusercontent.com

# Optional integrations (leave blank to disable)
SPOTIFY_CLIENT_ID=
SPOTIFY_REFRESH_TOKEN=
WEATHER_API_KEY=
HOME_LAT=
HOME_LON=

# Bank data (Budget page) is powered by SimpleFIN — no global env var needed.
# Each family member pastes a one-time SimpleFIN Bridge setup token into the
# Budget page; the server exchanges it for an access URL and stores it in
# Firestore under households/{uid}/bankSecrets, which firestore.rules denies
# to every client read/write.
