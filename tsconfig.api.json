{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true
  },
  "include": ["api/**/*.ts", "server/**/*.ts"],
  "exclude": ["api/**/*.test.ts", "server/**/*.test.ts"]
}
